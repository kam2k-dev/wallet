# ─── Database ────────────────────────────────────────────────────────────────
# DB_MODE: "dummy"  → uses a local JSON file (server/db/data.json) for dev.
#          "supabase" → uses Supabase Postgres for production.
DB_MODE="dummy"

# Supabase credentials (only needed when DB_MODE="supabase").
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ─── App ─────────────────────────────────────────────────────────────────────
# The URL where this app is hosted (used for self-referential links).
APP_URL="http://localhost:3000"

# Node environment: "development" or "production".
NODE_ENV="development"
