# ─── Database ────────────────────────────────────────────────────────────────
# DB_MODE: "dummy"  → uses a local JSON file (server/db/data.json) for dev.
#          "postgres" → uses PostgreSQL for production.
DB_MODE="dummy"

# PostgreSQL credentials (only needed when DB_MODE="postgres").
DATABASE_URL="postgresql://wallet_user:password_rahasia_anda@localhost:5432/wallet_db"

# ─── App ─────────────────────────────────────────────────────────────────────
# The URL where this app is hosted (used for self-referential links).
APP_URL="http://localhost:5000"

# Google OAuth Credentials
GOOGLE_CLIENT_ID="your_google_client_id_here.apps.googleusercontent.com"
VITE_GOOGLE_CLIENT_ID="your_google_client_id_here.apps.googleusercontent.com"

# Node environment: "development" or "production".
NODE_ENV="development"
